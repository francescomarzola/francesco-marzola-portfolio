{
  "name": "Sito",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome mostrato nell'header"
    },
    "firma": {
      "type": "string",
      "description": "Sottotitolo/firma accanto al nome nell'header"
    },
    "ruolo": {
      "type": "string",
      "description": "Testo della pillola scura nel badge header (es. CEO & Chief Creative Officer)"
    },
    "foto_url": {
      "type": "string",
      "description": "URL della foto profilo tonda mostrata nel badge header"
    },
    "cta_label": {
      "type": "string",
      "description": "Etichetta del link CTA in header (es. Contattami)"
    },
    "email": {
      "type": "string",
      "description": "Email di destinazione mostrata nella modale di contatto e nel footer"
    },
    "modal_titolo": {
      "type": "string",
      "description": "Titolo della modale di contatto (es. Parliamone)"
    },
    "linkedin_url": {
      "type": "string",
      "description": "URL del profilo LinkedIn mostrato nel footer"
    },
    "footer_testo": {
      "type": "string",
      "description": "Testo copyright/sinistra del footer (es. \u00a9 2026 Francesco Marzola)"
    },
    "footer_link": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "etichetta": {
            "type": "string",
            "description": "Testo del link"
          },
          "url": {
            "type": "string",
            "description": "URL del link (https://... o mailto:...)"
          }
        }
      },
      "description": "Link aggiuntivi del footer (etichetta + URL)"
    },
    "progetti_titolo": {
      "type": "string",
      "description": "Heading della sezione progetti, mostrato sopra le card"
    },
    "nome_mobile": {
      "type": "string",
      "description": "Override mobile del nome header (vuoto = eredita da desktop)"
    },
    "firma_mobile": {
      "type": "string",
      "description": "Override mobile della firma (vuoto = eredita da desktop)"
    },
    "ruolo_mobile": {
      "type": "string",
      "description": "Override mobile del ruolo (vuoto = eredita da desktop)"
    },
    "foto_url_mobile": {
      "type": "string",
      "description": "Override mobile della foto profilo (vuoto = eredita da desktop)"
    },
    "cta_label_mobile": {
      "type": "string",
      "description": "Override mobile etichetta CTA (vuoto = eredita da desktop)"
    },
    "email_mobile": {
      "type": "string",
      "description": "Override mobile email di destinazione (vuoto = eredita da desktop)"
    },
    "modal_titolo_mobile": {
      "type": "string",
      "description": "Override mobile titolo modale contatto (vuoto = eredita da desktop)"
    },
    "progetti_titolo_mobile": {
      "type": "string",
      "description": "Override mobile heading sezione progetti (vuoto = eredita da desktop)"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}